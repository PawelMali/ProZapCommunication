                <MudStack Style="padding-left:10px; padding-right:10px; margin-top:10px;">
                    <MudPaper Class="pa-2 mb-2" Style="background-color: rgba(var(--mud-palette-primary-rgb), 0.15);">
                        <MudText Typo="Typo.h6" Color="Color.Primary">MFS Station 8 History (Motor assembly)</MudText>
                    </MudPaper>
                    <MudTable Items="@report.Station8History" Dense="true" Hover="true" Class="mb-6" Elevation="1" Style="width: auto; max-width: max-content;">
                        <HeaderContent>
                            <MudTh Class="text-center">Timestamp</MudTh>
                            <MudTh Class="text-center">Operator</MudTh>
                            <MudTh Class="text-center">SN/Motor Status</MudTh>
                            <MudTh Class="text-center">SN/Motor </MudTh>
                            <MudTh Class="text-center">Radiator Status</MudTh>
                            <MudTh Class="text-center">Radiator </MudTh>
                            <MudTh Class="text-center">MFS Status</MudTh>
                            <MudTh Class="text-center">MFS </MudTh>

                            <MudTh Class="text-center">Rework Code </MudTh>

                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Timestamp" Class="text-center">@context.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
                            <MudTd DataLabel="Operator" Class="text-center">@context.Operator_ID</MudTd>
                            <MudTd DataLabel="SN/Motor Status" Class="text-center">
                                <MudChip T="string" Color="@GetMainStatusColor(context.SN_Status)" Size="Size.Small">
                                    @GetMainStatusText(context.SN_Status) | @context.SN_Status
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="SN/Motor" Class="text-center">@context.SN</MudTd>

                            <MudTd DataLabel="Radiator Status" Class="text-center">
                                <MudChip T="string" Color="@GetMainStatusColor(context.Radiator_Status)" Size="Size.Small">
                                    @GetMainStatusText(context.Radiator_Status) | @context.Radiator_Status
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Radiator" Class="text-center">@context.Radiator_SN</MudTd>
                            <MudTd DataLabel="MFS Status" Class="text-center">
                                <MudChip T="string" Color="@GetMainStatusColor(context.Mfs_Status)" Size="Size.Small">
                                    @GetMainStatusText(context.Mfs_Status) | @context.Mfs_Status
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="MFS" Class="text-center">@context.Mfs_SN</MudTd>
                            <MudTd DataLabel="Rework Code" Class="text-center">@context.ReworkCode</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudStack>
            }

        </MudTabPanel>

    </MudTabs>
}

@code {
    private string selectedSearchType = "SN"; // Domyślnie szukamy po SN
    private string searchSubSn = string.Empty;
    private bool isLoading = false;
    private ProductionProcessReport? report;

    private async Task SearchData()
    {
        if (string.IsNullOrWhiteSpace(searchSubSn))
        {
            Snackbar.Add("Please enter a search value.", Severity.Warning);
            return;
        }

        isLoading = true;
        report = null;
        StateHasChanged();

        try
        {
            // Wywołanie nowej metody wyszukującej po dowolnym typie
            report = await Repository.GetReportByAnyIdentifierAsync(selectedSearchType, searchSubSn);
            
            if (report == null || report.TotalAttempts == 0)
            {
                Snackbar.Add($"No product history found for {selectedSearchType}: {searchSubSn}", Severity.Info);
                report = null;
            }
            else
            {
                Snackbar.Add("Data retrieved successfully.", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Database error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchData();
        }
    }

    private async Task DownloadExcel()
    {
        if (report == null) return;

        var fileBytes = ExportService.ExportToExcel(report);
        var fileName = $"Traceability_{report.SN}.xlsx";

        // Wywołujemy JavaScript, który pobierze plik w przeglądarce
        await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, Convert.ToBase64String(fileBytes));
        Snackbar.Add("Excel file downloaded successfully.", Severity.Success);
    }

    private async Task OpenVisualizationDialog()
    {
        if (report == null) return;

        // Przekazujemy raport jako parametr do okna dialogowego
        var parameters = new DialogParameters<VisualizationDialog>
    {
        { x => x.Report, report }
    };

        // Konfigurujemy opcje wyświetlania popupa (szerokość dostosowana pod obrazek 800px)
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true,
            BackdropClick = true
        };

        await DialogService.ShowAsync<VisualizationDialog>("Component Visualization", parameters, options);
    }



    # region Status coloring metchods
    private Color GetVisionStatusColor(int? status) => status switch
    {
        1 => Color.Success, //OK
        2 => Color.Error,   //NOK
        3 => Color.Warning,    //Manual confirmation OK
        4 => Color.Warning, //Disabled
        null => Color.Error,
        _ => Color.Error
    };

    private string GetVisionStatusText(int? status) => status switch
    {
        1 => "OK",
        2 => "NOK",
        3 => "MANUAL OK",
        4 => "DISABLED",
        null => "UNKNOWN",
        _ => "UNKNOWN"
    };

    private string GetLeakMethodStatusText(int? status) => status switch
    {
        1 => "Pressure difference",
        2 => "Leakrate",
        null => "UNKNOWN",
        _ => "UNKNOWN"
    };

    private string GetScrewStyle(int? status) => status switch
    {
        1 => "color: var(--mud-palette-success);",
        2 => "color: var(--mud-palette-error);",
        null => "color: var(--mud-palette-error);",
        _ => "color: var(--mud-palette-error);"
    };  
    
    private Color GetQrQualityColor(char quality)
    {
        return quality switch
        {
            'A' => Color.Success,
            'B' => Color.Success,
            'C' => Color.Warning,
            'D' => Color.Warning,
            'E' => Color.Error,
            _ => Color.Error,
        };
    }

    private Color GetMainStatusColor(int? status) => status switch
    {
        1 => Color.Success, //OK
        2 => Color.Error,   //NOK
        >= 3000 and < 4000 => Color.Warning, //Rework
        4 => Color.Error, //Disabled
        null => Color.Default,
        _ => Color.Default
    };

    private string GetMainStatusText(int? status) => status switch
    {
        1 => "OK",
        2 => "NOK",
        >= 3000 and < 4000 => "REWORK",
        4 => "SCRAP",
        null => "UNKNOWN",
        _ => "UNKNOWN"
    };


    #endregion

}
