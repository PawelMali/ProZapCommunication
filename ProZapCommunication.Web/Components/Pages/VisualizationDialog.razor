@using ProZapCommunication.Web.Models
@using ProZapCommunication.Web.Services

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Visibility" Class="mr-2" Color="Color.Info" />
            <MudText Typo="Typo.h6">Component Status Visualization (SN: @Report.SN)</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column align-center">
            
            <!-- Kontener o stałej szerokości 800px -->
            <div style="position: relative; width: 800px; height: 600px; border: 1px solid var(--mud-palette-lines-inputs); border-radius: 8px; overflow: hidden; background-color: #f5f5f5;">
                
                <!-- Obrazek w tle -->
                <img src="images/st1_1.jpg" style="width: 100%; height: 100%; object-fit: contain; display: block;" alt="Assembly Layout" />

                <!-- Warstwa SVG -->
                <svg style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;" viewBox="0 0 800 600" preserveAspectRatio="none">
                    
                    <!-- PRZYKŁAD 1: Grommet Left (Stacja 1) -->
                    @if (LatestStation1 != null)
                    {
                        <rect x="180" y="170" width="60" height="50"
                              fill="@GetSvgHexColor(GetVisionStatusColor(LatestStation1.Grommet_Left_Bottom_Presence_Cam_1_Status))"
                              fill-opacity="0.5"
                              stroke="@GetSvgHexColor(GetVisionStatusColor(LatestStation1.Grommet_Left_Bottom_Presence_Cam_1_Status))"
                              stroke-width="2"
                              style="cursor: pointer;">
                            <title>Grommet Left Bottom (CAM1)&#10;Status: @GetVisionStatusText(LatestStation1.Grommet_Left_Bottom_Presence_Cam_1_Status)</title>
                        </rect>
                    }

                    <!-- PRZYKŁAD 2: Śruby ze stacji 5 -->
@*                     @if (LatestStation5 != null)
                    {
                        <circle cx="400" cy="250" r="15"
                                fill="@(LatestStation5.Screw1_Status ? "#2ecc71" : "#e74c3c")"
                                fill-opacity="0.6"
                                stroke="#fff"
                                stroke-width="1.5">
                            <title>Screw 1&#10;Torque: @LatestStation5.Screw1_Torque Nm&#10;Angle: @LatestStation5.Screw1_Angle°</title>
                        </circle>

                        <circle cx="450" cy="280" r="15"
                                fill="@(LatestStation5.Screw2_Status ? "#2ecc71" : "#e74c3c")"
                                fill-opacity="0.6"
                                stroke="#fff"
                                stroke-width="1.5">
                            <title>Screw 2&#10;Torque: @LatestStation5.Screw2_Torque Nm&#10;Angle: @LatestStation5.Screw2_Angle°</title>
                        </circle>
                    } *@

                    <!-- PRZYKŁAD 3: Test szczelności (Stacja 3) -->
@*                     @if (LatestStation3 != null)
                    {
                        <polygon points="350,50 450,50 480,120 320,120"
                                 fill="@GetSvgHexColor(GetVisionStatusColor(LatestStation3.LeakTest_Status))"
                                 fill-opacity="0.4"
                                 stroke="#fff">
                            <title>Leak Test Area&#10;Pressure: @LatestStation3.LeakTest_Pressure mPa&#10;Leak Rate: @LatestStation3.LeakTest_Leak_Rate μL/min</title>
                        </polygon>
                    } *@
                </svg>
            </div>

            <!-- Legenda pod rysunkiem -->
            <div class="d-flex justify-center gap-4 mt-4">
                <div class="d-flex align-center"><span class="mr-1" style="width:15px; height:15px; background:#2e7d32; display:inline-block; border-radius:3px;"></span> OK</div>
                <div class="d-flex align-center"><span class="mr-1" style="width:15px; height:15px; background:#d32f2f; display:inline-block; border-radius:3px;"></span> NOK</div>
                <div class="d-flex align-center"><span class="mr-1" style="width:15px; height:15px; background:#0288d1; display:inline-block; border-radius:3px;"></span> Manual OK</div>
                <div class="d-flex align-center"><span class="mr-1" style="width:15px; height:15px; background:#9e9e9e; display:inline-block; border-radius:3px;"></span> Disabled</div>
            </div>

        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public ProductionProcessReport Report { get; set; } = null!;

    // Pomocnicze właściwości pobierające najnowsze stany
    private Station1Result? LatestStation1 => Report.Station1History?.OrderByDescending(h => h.Timestamp).FirstOrDefault();
    private Station3Result? LatestStation3 => Report.Station3History?.OrderByDescending(h => h.Timestamp).FirstOrDefault();
    private Station5Result? LatestStation5 => Report.Station5History?.OrderByDescending(h => h.Timestamp).FirstOrDefault();

    private void Close() => MudDialog.Close();

    private string GetSvgHexColor(Color color) => color switch
    {
        Color.Success => "#00C853",
        Color.Error => "#d32f2f",
        Color.Info => "#0288d1",
        Color.Warning => "#ed6c02",
        _ => "#9e9e9e"
    };

    private Color GetVisionStatusColor(int? status) => status switch
    {
        1 => Color.Success,
        2 => Color.Error,
        3 => Color.Info,
        4 => Color.Default,
        _ => Color.Default
    };

    private string GetVisionStatusText(int? status) => status switch
    {
        1 => "OK",
        2 => "NOK",
        3 => "MANUAL OK",
        4 => "DISABLED",
        _ => "UNKNOWN"
    };
}
