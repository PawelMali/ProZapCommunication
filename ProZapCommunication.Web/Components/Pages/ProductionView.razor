    // Pomocnicza metoda walidująca dane przed eksportem
    private bool ValidateExportData<T>(IEnumerable<T>? data)
    {
        if (data == null || !data.Any())
        {
            Snackbar.Add("Empty data to export", Severity.Warning);
            return false;
        }

        int count = data.Count();
        if (count > MaxExportRows)
        {
            Snackbar.Add($"The maximum number of rows that can be exported is {MaxExportRows:#,##0}. You selected {count:#,##0} rows. Please modify the date range or filters.", Severity.Warning);

            return false;
        }

        return true;
    }


    private bool QuickFilterStation1(Station1Result item) => FilterResult(item, searchString1, item.SN, item.Radiator_SN);
    private bool QuickFilterStation2(Station2Result item) => FilterResult(item, searchString2, item.SN, item.MFS_SN);
    private bool QuickFilterStation3(Station3Result item) => FilterResult(item, searchString3, item.SN);
    private bool QuickFilterStation4(Station4Result item) => FilterResult(item, searchString4, item.SN);
    private bool QuickFilterStation5(Station5Result item) => FilterResult(item, searchString5, item.Motor_SN);
    private bool QuickFilterStation6(Station6Result item) => FilterResult(item, searchString6, item.Motor_SN);
    private bool QuickFilterStation7(Station7Result item) => FilterResult(item, searchString7, item.Motor_SN, item.Mfs_SN);
    private bool QuickFilterStation8(Station8Result item) => FilterResult(item, searchString8, item.SN, item.Radiator_SN, item.Motor_SN, item.Mfs_SN);

    private bool FilterResult(object item, string searchString, params string[] fieldsToSearch)
    {
        if (string.IsNullOrWhiteSpace(searchString)) return true;
        foreach (var field in fieldsToSearch)
        {
            if (!string.IsNullOrEmpty(field) && field.Contains(searchString, StringComparison.OrdinalIgnoreCase))
                return true;
        }
        return false;
    }

    #region Status coloring metchods
    private Color GetVisionStatusColor(int? status) => status switch
    {
        1 => Color.Success, //OK
        2 => Color.Error,   //NOK
        3 => Color.Warning,    //Manual confirmation OK
        4 => Color.Warning, //Disabled
        null => Color.Error,
        _ => Color.Error
    };

    private string GetVisionStatusText(int? status) => status switch
    {
        1 => "OK",
        2 => "NOK",
        3 => "MANUAL OK",
        4 => "DISABLED",
        null => "UNKNOWN",
        _ => "UNKNOWN"
    };

    
    private string GetScrewStyle(bool status)
    {

        return status
            ? "color: var(--mud-palette-success);"
            : "color: var(--mud-palette-error);";

    }

    private Color GetMainStatusColor(int? status) => status switch
    {
        1 => Color.Success, //OK
        2 => Color.Error,   //NOK
        >= 3000 and < 4000 => Color.Warning, //Rework
        4 => Color.Error, //Disabled
        null => Color.Default,
        _ => Color.Default
    };

    private string GetMainStatusText(int? status) => status switch
    {
        1 => "OK",
        2 => "NOK",
        >= 3000 and < 4000 => "REWORK",
        4 => "SCRAP",
        null => "UNKNOWN",
        _ => "UNKNOWN"
    };


    #endregion
