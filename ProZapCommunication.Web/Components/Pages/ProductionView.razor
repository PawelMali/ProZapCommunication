@page "/production"
@using ProZapCommunication.Web.Database
@using ProZapCommunication.Web.Models
@using ProZapCommunication.Web.Services
@inject ReportRepository Repository
@inject ExportService ExportService
@inject IJSRuntime JS
@inject ISnackbar Snackbar


<MudText Typo="Typo.h4" Class="mb-6">Production Overview</MudText>

<MudPaper Elevation="2" Class="pa-4 mb-6">
    <MudGrid ContentAlignment="HorizontalAlignment.Center">
        <MudItem xs="12" sm="4" md="3">
            <MudDatePicker @bind-Date="dateFrom" Label="From Date" Editable="true" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="4" md="3">
            <MudDatePicker @bind-Date="dateTo" Label="To Date" Editable="true" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="3" md="2">
            <MudSelect @bind-Value="selectedStationId" Label="Stanowisko" Variant="Variant.Outlined">
                <MudSelectItem Value="1">CRFM 1</MudSelectItem>
                <MudSelectItem Value="2">CRFM 2</MudSelectItem>
                <MudSelectItem Value="3">CRFM 3</MudSelectItem>
                <MudSelectItem Value="4">CRFM 4</MudSelectItem>
                <MudSelectItem Value="5">MFS 1</MudSelectItem>
                <MudSelectItem Value="6">MFS 2</MudSelectItem>
                <MudSelectItem Value="7">MFS 3</MudSelectItem>
                <MudSelectItem Value="8">Rework</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4" md="2">
            <MudSelect @bind-Value="filterStatus" Label="Global Status" Variant="Variant.Outlined" Clearable="true">
                <MudSelectItem Value="((int?)1)">OK Only</MudSelectItem>
                <MudSelectItem Value="((int?)2)">NOK Only</MudSelectItem>
                <MudSelectItem Value="((int?)3)">REWORK Only</MudSelectItem>
                <MudSelectItem Value="((int?)4)">SCRAP Only</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="12" md="2" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RefreshAllTabs"
                       StartIcon="@Icons.Material.Filled.Refresh" Size="Size.Large" FullWidth="true" Disabled="@isLoading">
                @if (isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Load Production Data
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<div class="mb-4 d-flex gap-2">
    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Download" OnClick='() => DownloadCurrentTabExcel()' Size="Size.Medium" Disabled="@(isLoading || isExporting)">
        @if (isExporting)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
        }
        Export Current View to Excel
    </MudButton>
    
    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Description" OnClick='() => DownloadCurrentTabCsv()' Size="Size.Medium" Disabled="@(isLoading || isExporting)">
        @if (isExporting)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
        }
        Export Current View to CSV
    </MudButton>
</div>

