            {
                case 1:
                    station1Data = await Repository.GetStationDataAsync<Station1Result>(1, dateFrom.Value, dateTo.Value, filterStatus);
                    break;
                case 2:
                    station2Data = await Repository.GetStationDataAsync<Station2Result>(2, dateFrom.Value, dateTo.Value, filterStatus);
                    break;
                case 3:
                    station3Data = await Repository.GetStationDataAsync<Station3Result>(3, dateFrom.Value, dateTo.Value, filterStatus);
                    break;
                case 4:
                    station4Data = await Repository.GetStationDataAsync<Station4Result>(4, dateFrom.Value, dateTo.Value, filterStatus);
                    break;
                case 5:
                    station5Data = await Repository.GetStationDataAsync<Station5Result>(5, dateFrom.Value, dateTo.Value, filterStatus);
                    break;
                case 6:
                    station6Data = await Repository.GetStationDataAsync<Station6Result>(6, dateFrom.Value, dateTo.Value, filterStatus);
                    break;
                case 7:
                    station7Data = await Repository.GetStationDataAsync<Station7Result>(7, dateFrom.Value, dateTo.Value, filterStatus);
                    break;
                case 8:
                    station8Data = await Repository.GetStationDataAsync<Station8Result>(8, dateFrom.Value, dateTo.Value, filterStatus);
                    break;
            }

            if (isManualRefresh)
            {
                Snackbar.Add($"Data for Station {selectedStationId} loaded successfully.", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading data: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

