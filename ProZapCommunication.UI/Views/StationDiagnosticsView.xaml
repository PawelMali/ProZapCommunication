<UserControl x:Class="ProZapCommunication.UI.Views.StationDiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProZapCommunication.UI.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewModels="clr-namespace:ProZapCommunication.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="400">
    
    <materialDesign:Card Margin="10" Padding="15" UniformCornerRadius="8" Effect="{DynamicResource MaterialDesignShadowDepth2}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="{Binding StationName}" 
                           Style="{StaticResource MaterialDesignHeadline5TextBlock}" 
                           FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>

                <Grid Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="Communications: " FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ConnectionStatusText}" FontWeight="Bold" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="Red"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Foreground" Value="Green"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Life Signal: " Foreground="Gray"/>
                        <TextBlock Text="{Binding PlcLife, StringFormat={}{0}s}" FontWeight="Bold" Foreground="{DynamicResource SecondaryHueMidBrush}"/>
                    </StackPanel>
                </Grid>
                <Separator Margin="0,8,0,0"/>
            </StackPanel>


            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- PLC -> PC -->
                <GroupBox Grid.Column="0" Header="PLC -> PC" Style="{StaticResource MaterialDesignCardGroupBox}" Padding="2" Margin="0,0,6,0" materialDesign:ColorZoneAssist.Mode="PrimaryLight">
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding}" HorizontalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>

                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Task:" FontSize="13" Margin="0,0,4,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding PlcToPcTask}" FontSize="13" FontWeight="Bold" Margin="0,0,12,0"/>

                        <TextBlock Grid.Column="2" Text="Confirmation:" FontSize="13" Margin="0,0,4,0"/>
                        <TextBlock Grid.Column="3" Text="{Binding PlcToPcConfirm}" FontSize="13" FontWeight="Bold"/>
                    </Grid>
                </GroupBox>

                <!-- PC -> PLC -->
                <GroupBox Grid.Column="1" Header="PC -> PLC" Style="{StaticResource MaterialDesignCardGroupBox}" Padding="2" Margin="6,0,0,0" HorizontalContentAlignment="Center" materialDesign:ColorZoneAssist.Mode="PrimaryLight">
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding}" HorizontalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Task:" FontSize="13" Margin="0,0,4,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding PcToPlcTask}" FontSize="13" FontWeight="Bold" Margin="0,0,12,0"/>

                        <TextBlock Grid.Column="2" Text="Confirmation:" FontSize="13" Margin="0,0,4,0"/>
                        <TextBlock Grid.Column="3" Text="{Binding PcToPlcConfirm}" FontSize="13" FontWeight="Bold"/>
                    </Grid>
                </GroupBox>

            </Grid>



            <Border Grid.Row="3" Background="{DynamicResource MaterialDesignLinearProgressBackground}" Padding="0" CornerRadius="4" Margin="0,0,0,12">
                <StackPanel  >
                    <TextBlock Text="DMC Code sent to SQL database:" FontSize="13" FontWeight="SemiBold" Foreground="DimGray"/>
                    <TextBlock Text="{Binding CurrentDmc, TargetNullValue='[No active query / DMC code]'}" FontSize="13" FontWeight="SemiBold" Foreground="Black" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <GroupBox Grid.Row="4" Header="Operation Log (Last 6 tasks)" Style="{StaticResource MaterialDesignGroupBox}">
                <DataGrid ItemsSource="{Binding TaskHistory}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="None" Background="Transparent" GridLinesVisibility="None" RowHeight="28" ColumnHeaderHeight="38" FontSize="12" Padding="0" Margin="0">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="4,0"/>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="MinHeight" Value="20"/>
                        </Style>
                    </DataGrid.RowStyle>



                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="SizeToCells"/>

                        <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="SizeToCells">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Direction}" Value="PLC -> PC">
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Direction}" Value="PC -> PLC">
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryHueMidBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="SizeToCells"/>
                        <DataGridTextColumn Header="Operation" Binding="{Binding Description}" Width="*"/>

                        <DataGridTextColumn Header="Status / Result" Binding="{Binding Status}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOk}" Value="True">
                                            <Setter Property="Foreground" Value="Green"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsOk}" Value="False">
                                            <Setter Property="Foreground" Value="Red"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </materialDesign:Card>
</UserControl>
